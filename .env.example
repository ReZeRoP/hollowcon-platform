# Copy to .env on the server. Never commit the populated file.
NODE_ENV=production
DOMAIN=bot.example.com
PUBLIC_BASE_URL=https://bot.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://hollowcon:replace-with-the-url-encoded-password@postgres:5432/hollowcon
REDIS_URL=redis://redis:6379
TELEGRAM_BOT_TOKEN=replace-locally
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_MINI_APP_URL=https://bot.example.com/mini
INITIAL_OWNER_TELEGRAM_ID=0
PANEL_CREDENTIAL_MASTER_KEY=replace-with-at-least-32-random-characters
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
RECEIPT_STORAGE_PATH=/var/lib/hollowcon/receipts
RECEIPT_MAX_BYTES=8388608
PAYMENT_UNIQUE_SUFFIX_MIN=1
PAYMENT_UNIQUE_SUFFIX_MAX=999
PAYMENT_RESERVATION_MINUTES=30
DEFAULT_LOCALE=fa
LOG_LEVEL=info
# Container service ports are fixed internally by Compose and are not published.
BACKUP_RETENTION_DAYS=14
