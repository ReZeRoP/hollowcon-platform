generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  fa
  en
}

enum Role {
  owner
  admin
  finance
  support
  server_operator
  marketing
  auditor
}

enum OrderStatus {
  draft
  awaiting_receipt
  under_review
  approved
  rejected
  expired
  cancelled
}

enum ProvisioningStatus {
  queued
  running
  verifying
  provisioned
  delivered
  failed
  compensating
  manual_review
}

enum CustomerOrderMode {
  disabled
  owner_test
  enabled
}

enum SubscriptionStatus {
  pending
  active
  suspended
  expired
  migrating
  cancelled
}

enum ReceiptProcessingStatus {
  pending
  validated
  rejected
}

enum NotificationStatus {
  pending
  sending
  delivered
  failed
  manual_review
}

model SystemSettings {
  id                     Int      @id @default(1)
  setupCompletedAt       DateTime?
  termsVersion           String   @default("1")
  defaultLocale          Locale   @default(fa)
  supportContact         String?
  customerOrdersEnabled  Boolean           @default(false)
  customerOrderMode      CustomerOrderMode @default(disabled)
  panelMutationsEnabled  Boolean           @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model User {
  id                   String         @id @default(cuid())
  telegramId           BigInt         @unique
  username             String?
  firstName            String?
  phone                 String?
  locale                Locale         @default(fa)
  role                  Role?
  roleAssignedAt        DateTime?
  roleRevokedAt         DateTime?
  disabledAt            DateTime?
  termsAcceptedAt       DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  orders                Order[]
  subscriptions         Subscription[]
  auditEvents           AuditEvent[]    @relation("AuditActor")
  reviewedPayments      PaymentReview[] @relation("PaymentReviewer")
  sessions              AdminSession[]
  notifications         Notification[]
}

model AdminSession {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  csrfHash    String
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model Plan {
  id              String   @id @default(cuid())
  slug            String   @unique
  nameFa          String
  nameEn          String
  priceRial       BigInt
  durationDays    Int
  trafficBytes    BigInt
  deviceLimit     Int      @default(0)
  protocol        String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]
  eligibleInbounds PlanInbound[]
}

model RecipientCard {
  id                String   @id @default(cuid())
  panEncrypted      String
  panKeyId          String   @default("primary")
  panLastFour       String
  cardholderName    String
  active            Boolean  @default(true)
  pendingLimit      Int      @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  orders            Order[]
}

model Order {
  id                  String             @id @default(cuid())
  userId              String
  planId              String
  recipientCardId     String
  status              OrderStatus        @default(draft)
  baseAmountRial      BigInt
  uniqueSuffixRial    Int
  payableAmountRial   BigInt
  idempotencyKey      String             @unique
  planNameFa          String
  planNameEn          String
  durationDays        Int
  trafficBytes        BigInt
  deviceLimit         Int
  protocol            String
  reservationExpires  DateTime
  version             Int                @default(0)
  approvedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id])
  plan                 Plan               @relation(fields: [planId], references: [id])
  recipientCard        RecipientCard      @relation(fields: [recipientCardId], references: [id])
  receipts             PaymentReceipt[]
  reviews              PaymentReview[]
  provisioning         ProvisioningJob?
  subscription         Subscription?

  @@index([status, reservationExpires])
  @@index([userId, createdAt])
}

model PaymentReceipt {
  id              String   @id @default(cuid())
  orderId         String
  revision        Int      @default(1)
  current         Boolean  @default(true)
  replacedAt      DateTime?
  storageKey      String   @unique
  mediaType         String
  detectedMediaType String
  originalFileName  String?
  telegramFileId    String?
  byteSize          Int
  sha256            String
  perceptualHash    String?
  duplicateCount    Int                     @default(0)
  processingStatus  ReceiptProcessingStatus @default(validated)
  submittedAt       DateTime                @default(now())
  order           Order    @relation(fields: [orderId], references: [id])

  @@unique([orderId, revision])
  @@index([orderId, current])
  @@index([sha256])
  @@index([perceptualHash])
}

model PaymentReview {
  id          String   @id @default(cuid())
  orderId     String
  reviewerId  String
  approved    Boolean
  reason      String
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
  reviewer    User     @relation("PaymentReviewer", fields: [reviewerId], references: [id])

  @@index([orderId, createdAt])
}

model Panel {
  id                   String   @id @default(cuid())
  name                 String
  baseUrl              String   @unique
  apiTokenEncrypted    String
  apiTokenKeyId        String   @default("primary")
  expectedVersion      String   @default("3.5.0")
  enabled              Boolean  @default(true)
  weight               Int      @default(100)
  consecutiveFailures  Int      @default(0)
  circuitOpenUntil     DateTime?
  lastHealthyAt        DateTime?
  lastErrorCode        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  inbounds              PanelInbound[]
  subscriptions         Subscription[]
}

model PanelInbound {
  id              String        @id @default(cuid())
  panelId         String
  remoteId        Int
  tag             String
  remark          String
  protocol        String
  port            Int
  enabled         Boolean       @default(true)
  capacity        Int?
  activeClients   Int           @default(0)
  lastSyncedAt    DateTime?
  panel           Panel         @relation(fields: [panelId], references: [id])
  subscriptions   Subscription[]
  eligiblePlans   PlanInbound[]

  @@unique([panelId, remoteId])
  @@index([enabled, protocol])
}

model PlanInbound {
  planId         String
  panelInboundId String
  createdAt      DateTime     @default(now())
  plan           Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  panelInbound   PanelInbound @relation(fields: [panelInboundId], references: [id], onDelete: Cascade)

  @@id([planId, panelInboundId])
  @@index([panelInboundId])
}

model ProvisioningJob {
  id              String             @id @default(cuid())
  orderId         String             @unique
  status          ProvisioningStatus @default(queued)
  idempotencyKey  String             @unique
  attempts        Int                @default(0)
  nextAttemptAt   DateTime           @default(now())
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  lastErrorCode   String?
  lastErrorSafe   String?
  lockedAt        DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  order           Order              @relation(fields: [orderId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  orderId           String             @unique
  panelId           String
  panelInboundId    String
  remoteClientEmail String
  remoteSubId       String?
  status            SubscriptionStatus @default(pending)
  trafficBytes      BigInt
  expiresAt         DateTime
  linksEncrypted    String?
  linksKeyId        String?
  provisionedAt     DateTime?
  deliveredAt       DateTime?
  trafficUsedBytes  BigInt           @default(0)
  lastReconciledAt  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id])
  order             Order              @relation(fields: [orderId], references: [id])
  panel             Panel              @relation(fields: [panelId], references: [id])
  panelInbound      PanelInbound       @relation(fields: [panelInboundId], references: [id])

  @@unique([panelId, remoteClientEmail])
  @@index([userId, status])
}

model OutboxEvent {
  id             String    @id @default(cuid())
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  idempotencyKey String    @unique
  availableAt    DateTime  @default(now())
  processedAt    DateTime?
  attempts       Int       @default(0)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  lastErrorSafe  String?
  createdAt      DateTime  @default(now())

  @@index([processedAt, availableAt])
  @@index([leaseExpiresAt])
}

model Notification {
  id             String             @id @default(cuid())
  userId         String
  channel        String
  template       String
  payload        Json
  status         NotificationStatus @default(pending)
  idempotencyKey String             @unique
  attempts       Int                @default(0)
  availableAt    DateTime           @default(now())
  deliveryStep   Int                @default(0)
  messageIds     Json?
  deliveredAt    DateTime?
  leaseOwner     String?
  leaseExpiresAt DateTime?
  lastErrorSafe  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([leaseExpiresAt])
}

model AuditEvent {
  id             String   @id @default(cuid())
  actorId        String?
  action         String
  subjectType    String
  subjectId      String
  reason         String?
  correlationId  String
  ipHash         String?
  metadata       Json
  createdAt      DateTime @default(now())
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([subjectType, subjectId, createdAt])
  @@index([actorId, createdAt])
}
